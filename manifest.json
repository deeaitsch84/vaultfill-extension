{
  "manifest_version": 3,
  "name": "Vaultfill",
  "version": "0.1.0",
  "description": "Lean Vaultwarden autofill: suggests matching logins right at the login field.",
  "minimum_chrome_version": "127",
  "permissions": ["storage", "alarms", "idle", "favicon", "scripting", "clipboardWrite"],
  "commands": {
    "fill": {
      "suggested_key": { "default": "Ctrl+Shift+L", "mac": "Command+Shift+L" },
      "description": "Fill login / show suggestions"
    }
  },
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js", "type": "module" },
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "action": {
    "default_popup": "popup.html", "default_title": "Vaultfill",
    "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png" }
  },
  "content_scripts": [
    { "matches": ["<all_urls>"], "js": ["content.js"], "all_frames": true, "run_at": "document_idle" }
  ],
  "content_security_policy": { "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'" }
}
